{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dream-creater.local/contracts/dialogue.schema.json",
  "title": "Demo V2 Dialogue Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "locale", "questId", "nodes"],
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" },
    "locale": { "type": "string", "enum": ["zh-CN"] },
    "questId": { "type": "string", "x-idRegistry": "quests" },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "speakerId", "emotionId", "text"],
        "properties": {
          "id": { "type": "string", "x-idRegistry": "dialogueNodes" },
          "speakerId": { "type": "string", "x-idRegistry": "characters" },
          "emotionId": { "type": "string", "x-idRegistry": "emotions" },
          "questStateId": { "type": "string", "x-idRegistry": "questStates" },
          "text": { "type": "string", "minLength": 1 },
          "choices": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["label", "nextNodeId"],
              "properties": {
                "label": { "type": "string", "minLength": 1 },
                "nextNodeId": { "type": "string", "x-idRegistry": "dialogueNodes" },
                "eventDeltaId": { "type": "string", "x-idRegistry": "eventDeltas" }
              }
            }
          }
        }
      }
    }
  }
}
