{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tactical battle balance matrix",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "encounters"],
  "properties": {
    "version": { "type": "integer", "enum": [1] },
    "encounters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "battleId",
          "recommendedRankId",
          "recommendedEntryVariantId",
          "builds",
          "policies",
          "targets"
        ],
        "properties": {
          "battleId": { "type": "string", "x-idRegistry": "battles" },
          "recommendedRankId": {
            "type": "string",
            "x-idRegistry": "cultivationRanks"
          },
          "recommendedEntryVariantId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "builds": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "buildId",
                "rankId",
                "maxHealth",
                "maxEssence",
                "move",
                "attributes",
                "defenses",
                "actionIds",
                "publicItemUses"
              ],
              "properties": {
                "buildId": {
                  "type": "string",
                  "x-idRegistry": "battleBalanceReferenceBuilds"
                },
                "rankId": {
                  "type": "string",
                  "x-idRegistry": "cultivationRanks"
                },
                "maxHealth": { "type": "integer", "minimum": 1, "maximum": 999 },
                "maxEssence": { "type": "integer", "minimum": 0, "maximum": 999 },
                "move": { "type": "integer", "minimum": 0, "maximum": 12 },
                "attributes": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["strength", "perception"],
                  "properties": {
                    "strength": { "type": "integer", "minimum": 0, "maximum": 100 },
                    "perception": { "type": "integer", "minimum": 0, "maximum": 100 }
                  }
                },
                "defenses": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["physical", "gu"],
                  "properties": {
                    "physical": { "type": "integer", "minimum": 0, "maximum": 100 },
                    "gu": { "type": "integer", "minimum": 0, "maximum": 100 }
                  }
                },
                "actionIds": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "x-idRegistry": "battleActions" }
                },
                "publicItemUses": {
                  "type": "array",
                  "maxItems": 20,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["actionId", "remainingUses"],
                    "properties": {
                      "actionId": {
                        "type": "string",
                        "x-idRegistry": "battleActions"
                      },
                      "remainingUses": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 99
                      }
                    }
                  }
                }
              }
            }
          },
          "policies": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "x-idRegistry": "battleBalancePlayerPolicies"
            }
          },
          "targets": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "minimumVictories",
              "maximumVictories",
              "maximumVictoryRound",
              "maximumStallRate"
            ],
            "properties": {
              "minimumVictories": { "type": "integer", "minimum": 0, "maximum": 15 },
              "maximumVictories": { "type": "integer", "minimum": 0, "maximum": 15 },
              "maximumVictoryRound": { "type": "integer", "minimum": 1, "maximum": 100 },
              "maximumStallRate": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    }
  }
}
