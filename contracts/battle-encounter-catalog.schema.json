{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tactical battle encounter catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "encounters"],
  "properties": {
    "version": { "type": "integer", "enum": [1] },
    "encounters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "battleId",
          "tierId",
          "board",
          "entryVariants",
          "enemies",
          "enemyUnitOrder",
          "resultPolicy"
        ],
        "properties": {
          "battleId": { "type": "string", "x-idRegistry": "battles" },
          "tierId": { "type": "string", "x-idRegistry": "battleEncounterTiers" },
          "board": {
            "type": "object",
            "additionalProperties": false,
            "required": ["width", "height", "blockedCells"],
            "properties": {
              "width": { "type": "integer", "enum": [8] },
              "height": { "type": "integer", "enum": [6] },
              "blockedCells": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["x", "y", "kind"],
                  "properties": {
                    "x": { "type": "integer", "minimum": 0, "maximum": 7 },
                    "y": { "type": "integer", "minimum": 0, "maximum": 5 },
                    "kind": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    }
                  }
                }
              }
            }
          },
          "entryVariants": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["variantId", "mode"],
              "properties": {
                "variantId": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "mode": {
                  "type": "string",
                  "enum": ["battle", "directResult"]
                },
                "playerSpawn": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["x", "y"],
                  "properties": {
                    "x": { "type": "integer", "minimum": 0, "maximum": 7 },
                    "y": { "type": "integer", "minimum": 0, "maximum": 5 }
                  }
                },
                "startingPhase": {
                  "type": "string",
                  "enum": ["player", "enemy"]
                },
                "result": {
                  "type": "string",
                  "enum": ["retreat"]
                }
              }
            }
          },
          "enemies": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "unitId",
                "profileId",
                "spawn",
                "maxHealth",
                "maxEssence",
                "move",
                "attributes",
                "defenses",
                "actionIds"
              ],
              "properties": {
                "unitId": {
                  "type": "string",
                  "pattern": "^B-[A-Z0-9-]+\\.enemy\\.[12]$"
                },
                "profileId": {
                  "type": "string",
                  "x-idRegistry": "battleAiProfiles"
                },
                "spawn": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["x", "y"],
                  "properties": {
                    "x": { "type": "integer", "minimum": 0, "maximum": 7 },
                    "y": { "type": "integer", "minimum": 0, "maximum": 5 }
                  }
                },
                "maxHealth": { "type": "integer", "minimum": 1, "maximum": 999 },
                "maxEssence": { "type": "integer", "minimum": 0, "maximum": 999 },
                "move": { "type": "integer", "minimum": 0, "maximum": 12 },
                "attributes": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["strength", "perception"],
                  "properties": {
                    "strength": { "type": "integer", "minimum": 0, "maximum": 100 },
                    "perception": { "type": "integer", "minimum": 0, "maximum": 100 }
                  }
                },
                "defenses": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["physical", "gu"],
                  "properties": {
                    "physical": { "type": "integer", "minimum": 0, "maximum": 100 },
                    "gu": { "type": "integer", "minimum": 0, "maximum": 100 }
                  }
                },
                "actionIds": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": { "type": "string", "x-idRegistry": "battleActions" }
                },
                "audibleHidden": { "type": "boolean" }
              }
            }
          },
          "enemyUnitOrder": {
            "type": "array",
            "minItems": 1,
            "maxItems": 2,
            "uniqueItems": true,
            "items": { "type": "string" }
          },
          "resultPolicy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "simultaneousZero",
              "allowRetreat",
              "returnMode",
              "maxBalanceRounds"
            ],
            "properties": {
              "simultaneousZero": {
                "type": "string",
                "enum": ["playerVictory"]
              },
              "allowRetreat": { "type": "boolean" },
              "returnMode": { "type": "string", "enum": ["entryScene"] },
              "maxBalanceRounds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 100
              }
            }
          }
        }
      }
    }
  }
}
