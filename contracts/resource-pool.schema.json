{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dream-creater.local/contracts/resource-pool.schema.json",
  "title": "Bounded Current And Maximum Resource Pool",
  "type": "object",
  "additionalProperties": false,
  "required": ["current", "maximum"],
  "properties": {
    "current": { "type": "integer", "minimum": 0, "maximum": 9999 },
    "maximum": { "type": "integer", "minimum": 1, "maximum": 9999 }
  }
}
