{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dream-creater.local/contracts/buff-instance.schema.json",
  "title": "Active Buff Instance",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "duration"],
  "properties": {
    "id": { "type": "string", "x-idRegistry": "buffIds" },
    "duration": { "type": "string", "x-idRegistry": "statusDurations" },
    "remainingTurns": { "type": "integer", "minimum": 1, "maximum": 99 }
  }
}
