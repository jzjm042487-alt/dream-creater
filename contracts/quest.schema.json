{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dream-creater.local/contracts/quest.schema.json",
  "title": "Demo V2 Quest",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "initialStateId", "states", "transitions"],
  "properties": {
    "id": { "type": "string", "x-idRegistry": "quests" },
    "initialStateId": { "type": "string", "x-idRegistry": "questStates" },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "terminal"],
        "properties": {
          "id": { "type": "string", "x-idRegistry": "questStates" },
          "label": { "type": "string", "minLength": 1 },
          "terminal": { "type": "boolean" }
        }
      }
    },
    "transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to", "trigger"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_:-]+$" },
          "from": { "type": "string", "x-idRegistry": "questStates" },
          "to": { "type": "string", "x-idRegistry": "questStates" },
          "trigger": { "type": "string", "minLength": 1 },
          "eventDeltaId": { "type": "string", "x-idRegistry": "eventDeltas" }
        }
      }
    }
  }
}
