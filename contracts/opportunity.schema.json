{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dream-creater.local/contracts/opportunity.schema.json",
  "title": "MVP Opportunity State",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "status"],
  "properties": {
    "id": { "type": "string", "x-idRegistry": "opportunities" },
    "title": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "x-idRegistry": "opportunityStatuses" },
    "resolvedByCharacterId": { "type": "string", "x-idRegistry": "characters" },
    "resultId": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]+$" }
  }
}
